{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/kunko-ai/agent-assurance/schema/agent-assurance.schema.json",
  "title": "Agent Assurance Manifest",
  "description": "agent-assurance/v1 — the common representation every assurance check consumes.",
  "type": "object",
  "required": ["apiVersion", "agent"],
  "properties": {
    "apiVersion": { "const": "agent-assurance/v1" },
    "agent": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string", "default": "0.0.0" }
      }
    },
    "framework": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "model": {
      "type": "object",
      "properties": {
        "provider": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "type": {
            "enum": ["read", "write", "delete", "execute", "external_send", "financial"],
            "default": "read"
          },
          "system": { "type": "string" },
          "production": { "type": "boolean", "default": false },
          "irreversible": { "type": "boolean", "default": false }
        }
      }
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "enum": ["public", "internal", "pii", "financial", "credential", "health"],
            "default": "internal"
          },
          "systems": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "autonomy": { "type": "integer", "minimum": 0, "maximum": 5, "default": 1 },
    "delegation": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "subagents": { "type": "array", "items": { "type": "string" } }
      }
    },
    "policies": { "type": "array", "items": { "type": "string" } }
  }
}
